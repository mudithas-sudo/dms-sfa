// Company F&B DMS + SFA Prototype
// PostgreSQL via Prisma (hosted on Neon / Vercel Postgres). Status/type
// fields are plain strings rather than DB enums; allowed values are documented
// above each field and enforced in application code (see lib/constants.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Org / master data
// ---------------------------------------------------------------------------

model Branch {
  id            String   @id @default(cuid())
  name          String
  code          String?  @unique
  address       String
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  region        String?
  status        String   @default("active") // active | inactive
  activatedAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime @default(now())

  users               User[]
  outlets             Outlet[]
  warehouses          Warehouse[]
  vans                Van[]
  purchaseOrders      PurchaseOrder[]
  salesOrders         SalesOrder[]
  invoices            Invoice[]
  replenishmentRequests ReplenishmentRequest[]
}

model User {
  id           String  @id @default(cuid())
  name         String
  role         String // admin | branch_ops | supervisor | sales_rep | management
  branchId     String?
  branch       Branch? @relation(fields: [branchId], references: [id])
  routeId      String?
  route        Route?  @relation(fields: [routeId], references: [id])
  supervisorId String?
  supervisor   User?   @relation("UserSupervisor", fields: [supervisorId], references: [id])
  reports      User[]  @relation("UserSupervisor")
  active       Boolean @default(true)
  employeeCode String? @unique
  phone        String?
  email        String?
  branchScope  String? // comma-separated extra branch ids for multi-branch (regional) users
  mfaEnrolled  Boolean @default(false)
  statusEffectiveFrom DateTime?
  vanAssigned  Van?    @relation("VanAssignedUser")

  salesOrders       SalesOrder[]
  fieldVisits       FieldVisit[]
  auditLogs         AuditLog[]
  claims            Claim[]
  attendances       Attendance[]
  fieldNotes        FieldNote[]
  tasksAssigned     Task[]           @relation("TaskAssignedBy")
  tasksReceived     Task[]           @relation("TaskAssignedTo")
  leaveRequests     LeaveRequest[]
  expenseRequests   ExpenseRequest[]
}

model Channel {
  id           String        @id @default(cuid())
  name         String        @unique // General Trade | Modern Trade | Key Accounts
  code         String?       @unique
  status       String        @default("active") // active | inactive
  outlets      Outlet[]
  pricingRules PricingRule[]
  promotions   Promotion[]
  subChannels  SubChannel[]
}

// Master list of sub-channels per channel (e.g. GT -> Sari-Sari Store, Carinderia).
// Outlet.subChannel stays a free-text field for backward compatibility; this
// table is the admin-managed reference list new outlets should be picked from.
model SubChannel {
  id        String  @id @default(cuid())
  name      String
  code      String?
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id])
  status    String  @default("active") // active | inactive
}

// A geographic/organizational grouping of outlets that routes are set up within.
model Territory {
  id     String  @id @default(cuid())
  name   String
  code   String? @unique
  status String  @default("active") // active | inactive
  routes Route[]
}

model Route {
  id          String       @id @default(cuid())
  name        String
  code        String?
  visitDay    String?      // monday .. saturday
  frequency   String       @default("weekly") // weekly | fortnightly | monthly
  status      String       @default("active") // active | inactive
  territoryId String?
  territory   Territory?   @relation(fields: [territoryId], references: [id])
  outlets     Outlet[]
  reps        User[]
  stops       RouteStop[]
}

// The ordered "beat plan" — fixed outlet visiting sequence for a route.
model RouteStop {
  id       String @id @default(cuid())
  routeId  String
  route    Route  @relation(fields: [routeId], references: [id])
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])
  sequence Int
}

model Outlet {
  id                String   @id @default(cuid())
  name              String
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  channelId         String
  channel           Channel  @relation(fields: [channelId], references: [id])
  subChannel        String
  routeId           String?
  route             Route?   @relation(fields: [routeId], references: [id])
  address           String
  lat               Float
  lng               Float
  contactPerson     String?
  code              String?  @unique
  ownerName         String?
  phone             String?
  landline          String?
  email             String?
  visitDay          String?
  paymentTerms      String   @default("credit_30") // cash | credit_15 | credit_30 | credit_45
  creditLimit       Float    @default(0)
  creditStatus      String   @default("active") // active | on_watch | on_hold | blocked
  blockedReason     String?
  status            String   @default("active") // active | inactive | blocked
  onboardingStatus  String   @default("approved") // pending | approved | rejected | returned
  onboardingReason  String?
  businessRegRef    String?
  photoData         String?
  proposedRoute     String?
  proposedVisitDay  String?
  remarks           String?
  createdById       String?
  approvedById      String?
  priceListNote     String?
  previousChannelId String?
  channelEffectiveFrom DateTime?
  createdAt         DateTime @default(now())

  salesOrders   SalesOrder[]
  invoices      Invoice[]
  arLedger      ARLedgerEntry[]
  fieldVisits   FieldVisit[]
  pricingRules  PricingRule[]
  routeStops    RouteStop[]
  fieldNotes    FieldNote[]
  tasks         Task[]
  marketReturns MarketReturn[]
  creditNotes   CreditNote[]
}

model Product {
  id         String   @id @default(cuid())
  sku        String   @unique
  name       String
  uom        String // CS | PC | BTL etc.
  packSize   String?
  category   String
  hasExpiry  Boolean  @default(true)
  unitPrice  Float
  status     String   @default("active") // active | inactive | discontinued
  brand      String?
  shortName  String?
  sellingUnits String? // e.g. "PC,PK,CS"
  unitsPerPack Int    @default(1)
  minOrderQty Int     @default(1)
  shelfLifeDays Int?
  displayOrder Int?
  erpManaged Boolean  @default(true)

  stockBalances         StockBalance[]
  purchaseOrderLines    PurchaseOrderLine[]
  goodsReceiptLines     GoodsReceiptLine[]
  salesOrderLines       SalesOrderLine[]
  invoiceLines          InvoiceLine[]
  vanLoadLines          VanLoadLine[]
  stockCountLines       StockCountLine[]
  promotions            Promotion[]
  pricingRules          PricingRule[]
  stockTransfers        StockTransfer[]
  stockAdjustments      StockAdjustment[]
  vanReturns            VanReturn[]
  replenishmentRequests ReplenishmentRequest[]
  deliveryReceiptLines  DeliveryReceiptLine[]
  marketReturns         MarketReturn[]
  supplierReturns       SupplierReturn[]
}

// ---------------------------------------------------------------------------
// Stock locations (warehouse + van share the same stock-balance model)
// ---------------------------------------------------------------------------

model Warehouse {
  id       String @id @default(cuid())
  name     String
  code     String? @unique
  type     String  @default("saleable") // saleable | damaged | quarantine
  status   String  @default("active") // active | inactive
  address  String?
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  stockBalances    StockBalance[]
  goodsReceipts    GoodsReceipt[]
  stockCounts      StockCount[]
  vanLoadsFrom     VanLoad[]
  transfersOut     StockTransfer[] @relation("TransferFrom")
  transfersIn      StockTransfer[] @relation("TransferTo")
  stockAdjustments StockAdjustment[]
  vanReturns       VanReturn[]
  supplierReturns  SupplierReturn[]
}

model Van {
  id             String  @id @default(cuid())
  code           String  @unique
  plateNo        String
  driverName     String // display label; assignedUserId is the source of truth for lookups
  assignedUserId String? @unique
  assignedUser   User?   @relation("VanAssignedUser", fields: [assignedUserId], references: [id])
  status         String  @default("active") // active | inactive
  branchId       String
  branch         Branch  @relation(fields: [branchId], references: [id])

  stockBalances         StockBalance[]
  vanLoads              VanLoad[]
  vanReturns            VanReturn[]
  replenishmentRequests ReplenishmentRequest[]
}

// A stock balance row belongs to either a warehouse OR a van (locationType discriminates)
model StockBalance {
  id          String   @id @default(cuid())
  locationType String  // warehouse | van
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  vanId       String?
  van         Van?       @relation(fields: [vanId], references: [id])
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  lotNumber   String
  expiryDate  DateTime?
  qtyGood     Int        @default(0)
  qtyDamaged  Int        @default(0)
  qtyExpired  Int        @default(0) // past expiry; excluded from sale and allocation
  qtyQuarantine Int      @default(0) // held pending quality check; excluded from available
  qtyReserved Int        @default(0) // held against confirmed-not-yet-delivered orders; available = qtyGood - qtyReserved
  goodsReceiptLineId String?
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])
  updatedAt   DateTime   @updatedAt

  damageEvents StockDamageEvent[]

  @@index([productId])
  @@index([warehouseId])
  @@index([vanId])
}

// Logs every good<->bad reclassification (with an optional photo stub),
// replacing a silent qty-bucket mutation with an auditable event.
model StockDamageEvent {
  id             String       @id @default(cuid())
  stockBalanceId String
  stockBalance   StockBalance @relation(fields: [stockBalanceId], references: [id])
  qty            Int
  direction      String // good_to_bad | bad_to_good
  reason         String?
  photoPlaceholder Boolean    @default(false)
  createdBy      String
  createdAt      DateTime     @default(now())
}

// Warehouse-to-warehouse stock movement, requires approval before it posts.
model StockTransfer {
  id              String    @id @default(cuid())
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  lotNumber       String
  qty             Int
  status          String    @default("pending") // pending | approved | rejected | in_transit | completed | discrepancy
  requestedBy     String
  approvedBy      String?
  notes           String?
  approverRole    String?   // branch_manager | head_office — from the transfer value limit
  reversalOfId    String?
  dispatchedAt    DateTime?
  qtyReceived     Int?
  receivedBy      String?
  receivedAt      DateTime?
  discrepancyNote String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
}

// Reason-coded stock corrections (shrinkage, damage found, count correction), requires approval.
model StockAdjustment {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  lotNumber   String
  expiryDate  DateTime?
  qtyDelta    Int // positive = add, negative = remove
  reasonCode  String // damage | expiry | count_variance | loss_theft | data_entry | sample_promo | other
  status      String    @default("pending") // pending | approved | rejected
  approverRole String? // who must approve, from the size/value thresholds
  attachmentNote String?
  requestedBy String
  approvedBy  String?
  notes       String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
}

// Warehouse stock returned OUT to the supplier/manufacturer (e.g. expired,
// damaged or recalled goods sent back for credit) — distinct from VanReturn
// (van -> warehouse, stays inside the distributor) and MarketReturn
// (outlet -> rep). Requires approval before stock is deducted, then a
// separate "shipped" step once the goods actually leave the warehouse.
model SupplierReturn {
  id          String    @id @default(cuid())
  returnNumber String?  @unique
  destination String    @default("Central Warehouse")
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  lotNumber   String
  qty         Int
  reason      String // expired | damaged | recalled | other
  status      String    @default("pending") // draft | pending | approved | rejected | cancelled | shipped (in transit) | received | posted_to_erp
  requestedBy String
  approvedBy  String?
  notes       String?
  expiryDate  DateTime?
  dispatchedAt DateTime?
  qtyReceived Int?
  receivedBy  String?
  receivedAt  DateTime?
  discrepancyNote String?
  erpReference String?
  postedToErpAt DateTime?
  erpError    String?
  attachments String?   // JSON list of attached file names (photos / notes)
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
}

// Van -> warehouse returns (also covers "returns to central warehouse").
model VanReturn {
  id          String   @id @default(cuid())
  vanId       String
  van         Van      @relation(fields: [vanId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  lotNumber   String
  qty         Int
  condition   String   @default("good") // good | damaged
  reason      String?
  returnNumber String?
  qtyDeclared Int?
  qtyReceived Int?
  varianceReason String?
  receivedBy  String?
  status      String   @default("completed") // initiated | received | variance_pending | closed | completed
  returnedBy  String
  createdAt   DateTime @default(now())
}

// Rep-initiated request for more van stock; supervisor/branch-ops approves and fulfils via VanLoad.
model ReplenishmentRequest {
  id            String    @id @default(cuid())
  vanId         String
  van           Van       @relation(fields: [vanId], references: [id])
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  qtyRequested  Int
  requestNumber String?   @unique
  requiredDate  DateTime?
  remarks       String?
  decisionNote  String?
  status        String    @default("pending") // draft | pending | approved | partially_approved | rejected | fulfilled (loaded) | cancelled
  requestedBy   String
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  lines ReplenishmentLine[]
}

// One product line of a (multi-line) replenishment request.
model ReplenishmentLine {
  id             String               @id @default(cuid())
  requestId      String
  request        ReplenishmentRequest @relation(fields: [requestId], references: [id])
  productId      String
  qtyRequested   Int
  qtyApproved    Int?
  vanBalance     Int?
  warehouseAvail Int?
}

// ---------------------------------------------------------------------------
// Procurement
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id          String   @id @default(cuid())
  poNumber    String   @unique
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  status      String   @default("pending") // pending | partially_received | received | exception | cancelled
  supplier    String?
  exceptionReason String?
  orderDate   DateTime @default(now())
  expectedDate DateTime?

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  qtyOrdered      Int
  unitCost        Float
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  grNumber        String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  receivedDate    DateTime      @default(now())
  receivedBy      String
  hasAttachment   Boolean       @default(false)
  attachmentFilename String?
  status          String        @default("posted") // draft | pending_review | posted | cancelled | reversed
  reviewedBy      String?
  varianceNote    String?
  reversalOfId    String?
  postedAt        DateTime?

  lines       GoodsReceiptLine[]
  attachments GoodsReceiptAttachment[]
}

model GoodsReceiptAttachment {
  id             String       @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  filename       String
  docType        String       @default("delivery_receipt") // delivery_receipt | packing_list | damage_report | other
  description    String?
  uploadedBy     String
  createdAt      DateTime     @default(now())
}

model GoodsReceiptLine {
  id             String       @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  qtyExpected    Int
  qtyReceived    Int
  lotNumber      String
  expiryDate     DateTime?
  manufacturingDate DateTime?
  varianceReason String?

  stockBalances StockBalance[]
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model SalesOrder {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  outletId      String
  outlet        Outlet   @relation(fields: [outletId], references: [id])
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  salespersonId String
  salesperson   User     @relation(fields: [salespersonId], references: [id])
  status        String   @default("draft") // draft | confirmed | invoiced | delivered | voided
  orderDate     DateTime @default(now())
  requestedDeliveryDate DateTime?
  signatureDataUrl String?
  subtotal      Float    @default(0)
  discountTotal Float    @default(0)
  total         Float    @default(0)
  creditHoldReason String?
  voidReason    String?
  source        String   @default("sfa") // sfa | backend
  orderType     String   @default("pre_sales") // pre_sales | van_sale
  clientRef     String?  @unique // device-generated reference — a repeated submit returns the original order
  paymentTerms  String?
  remarks       String?
  deliveryAddress String?
  deliveryWindow String?
  urgentDelivery Boolean @default(false)
  urgentReason  String?
  allocationStatus String @default("not_allocated") // not_allocated | fully_allocated | partially_allocated | released | dispatched
  validationResult String? // JSON of every check outcome
  cancelReason  String?
  syncedAt      DateTime?
  capturedLat   Float?
  capturedLng   Float?

  lines         SalesOrderLine[]
  invoices      Invoice[]
  approvals     ApprovalRequest[]
  picklistLines PicklistLine[]
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  qty          Int
  unitPrice    Float
  discount     Float      @default(0)
  lineTotal    Float
  promotionId  String?
  promotion    Promotion? @relation(fields: [promotionId], references: [id])
  reservedLotNumber String? // the FEFO-picked warehouse lot reserved for this line, for backend orders
  qtyDelivered Int?        // actual delivered qty once fulfilled — may be less than qty (partial delivery)
  qtyBackorder Int         @default(0)
  qtyPicked    Int?

  picklistLines PicklistLine[]
}

// Warehouse picklist generated from allocated orders (single order or grouped by route/date).
model Picklist {
  id             String   @id @default(cuid())
  picklistNumber String   @unique
  branchId       String
  status         String   @default("generated") // generated | in_progress | picked | cancelled
  groupLabel     String?
  generatedBy    String
  pickedBy       String?
  pickedAt       DateTime?
  reprintCount   Int      @default(0)
  createdAt      DateTime @default(now())

  lines PicklistLine[]
}

model PicklistLine {
  id               String         @id @default(cuid())
  picklistId       String
  picklist         Picklist       @relation(fields: [picklistId], references: [id])
  salesOrderId     String
  salesOrder       SalesOrder     @relation(fields: [salesOrderId], references: [id])
  salesOrderLineId String
  salesOrderLine   SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])
  productId        String
  lotNumber        String?
  expiryDate       DateTime?
  location         String?
  qtyToPick        Int
  qtyPicked        Int?
  overrideReason   String?
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  salesOrderId  String
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id])
  outletId      String
  outlet        Outlet   @relation(fields: [outletId], references: [id])
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  invoiceDate   DateTime @default(now())
  dueDate       DateTime
  amount        Float
  taxAmount     Float    @default(0)
  branchSeq     Int?
  status        String   @default("unpaid") // unpaid | partially_paid | paid | overdue | voided
  deliveryStatus String  @default("delivered") // pending_delivery | out_for_delivery | delivered | partially_delivered | redelivery_scheduled | returned

  lines            InvoiceLine[]
  undelivered      UndeliveredBalance[]
  deliveryReceipts DeliveryReceipt[]
  arLedgerEntries  ARLedgerEntry[]
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Float
  lineTotal Float
}

model DeliveryReceipt {
  id           String   @id @default(cuid())
  drNumber     String   @unique
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  deliveredAt  DateTime @default(now())
  receivedBy   String
  status       String   @default("delivered") // delivered | partial | failed
  signatoryName String?
  signatureDataUrl String?

  lines DeliveryReceiptLine[]
}

// Remainder of a partially-delivered invoice — tracked until re-delivered, returned to stock or cancelled.
model UndeliveredBalance {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  productId   String
  qty         Int
  reason      String?
  status      String   @default("open") // open | redelivery_scheduled | returned_to_stock | cancelled
  redeliveryDate DateTime?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
}

// Per-line actual-delivered-vs-ordered, so a partial delivery is traceable.
model DeliveryReceiptLine {
  id                String          @id @default(cuid())
  deliveryReceiptId String
  deliveryReceipt   DeliveryReceipt @relation(fields: [deliveryReceiptId], references: [id])
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  qtyOrdered        Int
  qtyDelivered      Int
}

// ---------------------------------------------------------------------------
// Pricing rules (channel/customer level)
// ---------------------------------------------------------------------------

model PricingRule {
  id        String    @id @default(cuid())
  name      String
  level     String // channel | customer | sku
  kind      String    @default("pricing") // pricing | fixed_discount
  branchId  String?   // null = all branches
  scopeCategory String?
  approvalStatus String @default("active") // draft | pending_approval | active | ended | rejected
  approvedBy String?
  remarks   String?
  channelId String?
  channel   Channel?  @relation(fields: [channelId], references: [id])
  outletId  String?
  outlet    Outlet?   @relation(fields: [outletId], references: [id])
  productId String?
  product   Product?  @relation(fields: [productId], references: [id])
  priceType String // fixed_price | discount_percent
  value     Float
  startDate DateTime
  endDate   DateTime?
  status    String    @default("active") // active | expired
  createdAt DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Trade promotions & claims
// ---------------------------------------------------------------------------

model Promotion {
  id             String   @id @default(cuid())
  name           String
  type           String // volume_discount | free_good | price_off | rebate
  eligibilityRule String  // free-text description, kept for display alongside the structured minQty check
  minQty         Int?    // structured eligibility condition: order line qty must be >= this to apply
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  channelId      String?
  channel        Channel? @relation(fields: [channelId], references: [id])
  discountValue  Float   // percent discount for volume_discount/price_off/rebate
  freeQty        Int?    // free units granted per qualifying line, for type = free_good
  startDate      DateTime
  endDate        DateTime
  status         String   @default("active") // draft | approved | active | suspended | expired
  code           String?  @unique
  config         String?  // JSON for bundle / value-based / quantity-slab parameters
  maxDiscountCap Float?
  minOrderValue  Float?
  budget         Float?
  budgetUsed     Float    @default(0)
  maxRedemptions Int?
  redemptions    Int      @default(0)
  stacking       String   @default("none") // none | with_promotions | with_fixed_discount | both
  priority       Int      @default(0)
  version        Int      @default(1)
  parentId       String?
  branchIds      String?  // comma-separated; empty = all branches
  daysOfWeek     String?
  approvedBy     String?
  createdBy      String?
  suspendReason  String?
  notes          String?

  salesOrderLines SalesOrderLine[]
  claims          Claim[]
}

model Claim {
  id           String   @id @default(cuid())
  claimNumber  String   @unique
  promotionId  String
  promotion    Promotion @relation(fields: [promotionId], references: [id])
  submittedById String
  submittedBy  User     @relation(fields: [submittedById], references: [id])
  amount       Float
  status       String   @default("submitted") // draft | submitted | under_review | returned | approved | rejected | settlement_pending | settled (legacy: reviewed)
  submittedAt  DateTime @default(now())
  notes        String?
  branchId     String?
  periodStart  DateTime?
  periodEnd    DateTime?
  eligibleAmount Float?
  exceptionApproved Boolean @default(false)
  settlementReference String?
  documents    String?  // JSON list of attached document names
  tradePromoStatus String? // status returned from the trade-promotion application

  statusHistory ClaimStatusHistory[]
  lines         ClaimLine[]
}

model ClaimLine {
  id           String @id @default(cuid())
  claimId      String
  claim        Claim  @relation(fields: [claimId], references: [id])
  salesOrderId String
  orderNumber  String
  amount       Float
}

model ClaimStatusHistory {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id])
  status    String
  changedBy String
  changedAt DateTime @default(now())
  reason    String?
}

// ---------------------------------------------------------------------------
// Approvals (credit limit exceptions, discount overrides, order voids, ...)
// ---------------------------------------------------------------------------

model ApprovalRequest {
  id              String   @id @default(cuid())
  type            String // credit_limit_exception | discount_override | stock_shortage | price_promo_mismatch | order_void | ar_reversal
  salesOrderId    String?
  salesOrder      SalesOrder? @relation(fields: [salesOrderId], references: [id])
  arLedgerEntryId String?
  arLedgerEntry   ARLedgerEntry? @relation(fields: [arLedgerEntryId], references: [id])
  requestedBy     String
  amount          Float
  reason          String
  branchId        String?
  outletId        String?
  level           Int      @default(1)
  payload         String?  // JSON context (e.g. proposed override, return details)
  refId           String?  // id of the related record for non-order types
  status          String   @default("pending") // pending | approved | rejected | returned
  decidedBy       String?
  decisionNote    String?
  createdAt       DateTime @default(now())
  decidedAt       DateTime?
}

// ---------------------------------------------------------------------------
// AR / collections
// ---------------------------------------------------------------------------

model ARLedgerEntry {
  id               String   @id @default(cuid())
  outletId         String
  outlet           Outlet   @relation(fields: [outletId], references: [id])
  invoiceId        String?
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  type             String // invoice | payment | credit_note | debit_note | adjustment | write_off | void_reversal | reversal
  method           String? // cash | cheque | bank_transfer | other (only for payments)
  amount           Float
  balance          Float
  entryDate        DateTime @default(now())
  reference        String?
  chequeNumber     String?
  chequeBank       String?
  chequeBranch     String?
  chequeDate       DateTime?
  paymentStatus    String?  // pending (post-dated / uncleared) | cleared | bounced
  recStatus        String   @default("matched") // unmatched | partially_matched | matched | cleared | reversed
  unappliedAmount  Float    @default(0)
  collectedBy      String?
  clientRef        String?  @unique
  depositStatus    String   @default("not_deposited") // not_deposited | handed_in | banked
  depositedAt      DateTime?
  reversalRequests ApprovalRequest[]
}

// Debit note / adjustment / write-off — approved before posting to the ledger.
model FinancialDocument {
  id           String    @id @default(cuid())
  docNumber    String    @unique
  type         String    // debit_note | adjustment | write_off
  outletId     String
  invoiceId    String?
  amount       Float     // always positive; type + direction decide the ledger effect
  direction    String    @default("increase") // increase | decrease (adjustments only)
  reason       String
  status       String    @default("pending") // pending | approved | rejected | posted
  requestedBy  String
  approvedBy   String?
  decisionNote String?
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?
}

// Reduces an outlet's AR balance (from a market return or goodwill adjustment).
model CreditNote {
  id         String   @id @default(cuid())
  noteNumber String   @unique
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  amount     Float
  reason     String
  status     String   @default("issued") // proposed | pending_approval | approved | applied | rejected | issued (legacy) | void
  invoiceId  String?
  approvedBy String?
  decisionNote String?
  issuedBy   String
  issuedAt   DateTime @default(now())

  marketReturn MarketReturn?
}

// ---------------------------------------------------------------------------
// Van loading
// ---------------------------------------------------------------------------

model VanLoad {
  id          String   @id @default(cuid())
  vanId       String
  van         Van      @relation(fields: [vanId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  loadedAt    DateTime @default(now())
  loadedBy    String
  status      String   @default("pending") // pending | approved | rejected — stock only moves on approval
  approvedBy  String?
  decidedAt   DateTime?
  confirmedAt DateTime? // rep's own acknowledgement of receipt, from the SFA app
  loadNumber  String?  @unique
  replenishmentRequestId String?
  varianceReason String?

  lines VanLoadLine[]
}

model VanLoadLine {
  id        String  @id @default(cuid())
  vanLoadId String
  vanLoad   VanLoad @relation(fields: [vanLoadId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  qtyApproved Int?
  varianceReason String?
  qtyAcknowledged Int?   // what the rep confirmed receiving on the device
  ackReason String?
  lotNumber String
}

// ---------------------------------------------------------------------------
// Stock count
// ---------------------------------------------------------------------------

model StockCount {
  id           String   @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  countedBy    String
  countedAt    DateTime @default(now())
  status       String   @default("open") // open | pending_approval | approved | rejected | closed
  approvedBy   String?
  type         String   @default("full") // full | cycle
  scope        String?  // free text: category / rack / SKU set
  blind        Boolean  @default(false)
  tolerancePct Float?
  snapshotAt   DateTime?

  lines StockCountLine[]
}

model StockCountLine {
  id           String     @id @default(cuid())
  stockCountId String
  stockCount   StockCount @relation(fields: [stockCountId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  lotNumber    String
  systemQty    Int
  countedQty   Int
  variance     Int
  recountQty   Int?
  recountReason String?
}

// ---------------------------------------------------------------------------
// Field execution
// ---------------------------------------------------------------------------

model FieldVisit {
  id            String    @id @default(cuid())
  outletId      String
  outlet        Outlet    @relation(fields: [outletId], references: [id])
  salespersonId String
  salesperson   User      @relation(fields: [salespersonId], references: [id])
  checkinAt     DateTime  @default(now())
  checkinLat    Float
  checkinLng    Float
  checkoutAt    DateTime?
  checkoutLat   Float?
  checkoutLng   Float?
  feedback      String?
  photoPlaceholder Boolean @default(false)
  status        String    @default("in_progress") // in_progress | completed | skipped
  visitType     String    @default("planned") // planned | unplanned
  outcome       String?   // order_taken | collection_only | no_order | outlet_closed | owner_not_available
  noOrderReason String?
  serviceRating Int?
  complaint     String?
  complaintCategory String?
  followUp      Boolean   @default(false)
  followUpDue   DateTime?
  skipReason    String?
  distanceM     Float?
  outOfTolerance Boolean  @default(false)
  overrideReason String?
  mockLocation  Boolean   @default(false)
}

// Shelf audit, merchandising insight and competitor observation share the same
// shape (outlet + rep + free-text notes + optional photo), split by `type`.
model FieldNote {
  id            String   @id @default(cuid())
  outletId      String
  outlet        Outlet   @relation(fields: [outletId], references: [id])
  salespersonId String
  salesperson   User     @relation(fields: [salespersonId], references: [id])
  type          String // shelf_audit | merchandising | competitor
  notes         String
  data          String?  // JSON with the structured fields of the form
  photoPlaceholder Boolean @default(false)
  createdAt     DateTime @default(now())
}

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  assignedToId   String
  assignedTo     User      @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedById   String
  assignedBy     User      @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  outletId       String?
  outlet         Outlet?   @relation(fields: [outletId], references: [id])
  dueDate        DateTime?
  priority       String    @default("normal") // low | normal | high
  requiresPhoto  Boolean   @default(false)
  status         String    @default("pending") // pending (assigned) | acknowledged | in_progress | completed | not_completed | cancelled
  notes          String?
  notCompletedReason String?
  acknowledgedAt DateTime?
  startedAt      DateTime?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

// Market return capture; can be settled with a CreditNote.
model MarketReturn {
  id           String      @id @default(cuid())
  outletId     String
  outlet       Outlet      @relation(fields: [outletId], references: [id])
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  qty          Int
  reason       String // damaged | expired | near_expiry | wrong_item | overstock | quality_complaint
  photoPlaceholder Boolean @default(false)
  invoiceId    String?
  lotNumber    String?
  signatoryName String?
  signatureDataUrl String?
  outsidePolicy Boolean    @default(false)
  status       String      @default("pending") // pending | processed
  capturedBy   String
  createdAt    DateTime    @default(now())
  creditNoteId String?     @unique
  creditNote   CreditNote? @relation(fields: [creditNoteId], references: [id])
}

// ---------------------------------------------------------------------------
// Workforce administration (mobile) — marked conditional in the UI
// ---------------------------------------------------------------------------

model Attendance {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  dayDate   DateTime
  startAt   DateTime?
  startLat  Float?
  startLng  Float?
  endAt     DateTime?
  endLat    Float?
  endLng    Float?
  status    String    @default("in_progress") // in_progress | completed
  eodConfirmedAt DateTime? // rep's sign-off on the day's load/sold/returned reconciliation
  cashExpected   Float?
  cashDeclared   Float?
  cashVarianceReason String?
  startVariance  String? // on_time | late
  clockSkewFlag  Boolean @default(false)
  remarks        String?
  reopenedBy     String?
  reopenReason   String?
}

model LeaveRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  startDate  DateTime
  endDate    DateTime
  reason     String
  leaveType  String    @default("annual") // annual | sick | emergency
  halfDay    Boolean   @default(false)
  attachmentName String?
  decisionNote String?
  status     String    @default("pending") // pending | approved | rejected | returned | cancelled
  approvedBy String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
}

model ExpenseRequest {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  amount           Float
  category         String // travel | meals | fuel | other
  description      String
  receiptPlaceholder Boolean @default(false)
  expenseDate      DateTime?
  decisionNote     String?
  status           String    @default("pending") // pending | approved | partially_approved | rejected | paid
  approvedBy       String?
  createdAt        DateTime  @default(now())
  decidedAt        DateTime?
}

// ---------------------------------------------------------------------------
// Scheduled reports (config-only demo — no real cron)
// ---------------------------------------------------------------------------

model ScheduledReport {
  id                 String    @id @default(cuid())
  name               String
  reportType         String // sales_summary | ar_aging | inventory_valuation | claims_status
  scheduleDescription String  // free text e.g. "Every Monday 8:00 AM"
  recipientEmails    String
  status             String    @default("active") // active | inactive (paused)
  format             String    @default("excel") // excel | pdf | both
  filters            String?
  frequency          String?   // daily | weekly | monthly
  lastRunAt          DateTime?
  lastRunStatus      String?
  createdBy          String
  createdAt          DateTime  @default(now())

  runs ScheduledReportRun[]
}

model ScheduledReportRun {
  id         String          @id @default(cuid())
  reportId   String
  report     ScheduledReport @relation(fields: [reportId], references: [id])
  startedAt  DateTime        @default(now())
  status     String          // success | failed
  rowCount   Int?
  error      String?
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  entity     String
  entityId   String
  action     String // create | update | delete | void
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  summary    String
  beforeData String? // JSON-stringified snapshot, when applicable
  afterData  String? // JSON-stringified snapshot, when applicable
  branchId   String?
  role       String?
  source     String?  // web | sfa
  seq        Int      @default(autoincrement())
  prevHash   String?  // checksum of the previous entry — the chain makes tampering evident
  hash       String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Platform configuration, governance, integration and reporting (proposal v2.0)
// ---------------------------------------------------------------------------

// Key/value configuration maintained by administrators (thresholds, modes, policies).
model AppSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  role      String?
  branchId  String?
  title     String
  body      String
  link      String?
  kind      String    @default("info") // info | alert | approval
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Photo {
  id         String   @id @default(cuid())
  linkedType String   // visit | shelf_audit | merchandising | competitor | return | task | damage | expense
  linkedId   String?
  photoType  String   @default("other") // shelf | display | damaged_stock | competitor | delivery_proof | outlet_front | other
  caption    String?
  dataUrl    String
  outletId   String?
  uploadedBy String
  lat        Float?
  lng        Float?
  uploadStatus String @default("uploaded") // pending | uploading | uploaded | failed
  createdAt  DateTime @default(now())
}

model Target {
  id          String  @id @default(cuid())
  userId      String?
  branchId    String?
  metric      String  // sales_value | sales_volume | visit_compliance | productive_call_rate | collection | new_customers | task_completion
  period      String  // YYYY-MM
  targetValue Float
}

model ExportLog {
  id        String   @id @default(cuid())
  userId    String
  report    String
  filters   String?
  format    String
  rowCount  Int
  createdAt DateTime @default(now())
}

// Permission matrix, editable by administrators and enforced on the server.
model RolePermission {
  id     String @id @default(cuid())
  role   String
  module String
  level  String // none | view | edit | approve

  @@unique([role, module])
}

model DeviceRegistration {
  id              String    @id @default(cuid())
  userId          String    @unique
  deviceModel     String
  deviceId        String
  printerModel    String?
  status          String    @default("approved") // pending | approved | revoked
  registeredAt    DateTime  @default(now())
  lastSyncAt      DateTime?
  pendingItems    Int       @default(0)
  errorItems      Int       @default(0)
  oldestPendingAt DateTime?
  lastError       String?
}

model ApprovedHardware {
  id     String @id @default(cuid())
  kind   String // device | printer
  model  String
  status String @default("approved") // approved | retired
}

// Messages exchanged through the API gateway; failures sit here until corrected and resent.
model IntegrationMessage {
  id         String    @id @default(cuid())
  connector  String    // erp | sfa | trade_promotion | merchandising | bi
  direction  String    // inbound | outbound
  docType    String
  reference  String
  status     String    @default("ok") // ok | error | retrying | resolved | discarded
  error      String?
  retryCount Int       @default(0)
  payload    String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  resolution String?
}

model DuplicateLog {
  id         String    @id @default(cuid())
  clientRef  String
  docType    String
  userId     String?
  originalAt DateTime?
  repeatAt   DateTime  @default(now())
}

model BiExtract {
  id        String   @id @default(cuid())
  dataset   String
  consumer  String
  rowCount  Int
  status    String   @default("success")
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Stock movement ledger — every change to a balance, with the document behind it
// ---------------------------------------------------------------------------

model StockMovement {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  locationType  String   // warehouse | van
  warehouseId   String?
  vanId         String?
  productId     String
  lotNumber     String
  bucket        String   // good | damaged | expired | quarantine | in_transit
  qty           Int      // signed: positive adds to the bucket, negative removes
  balanceAfter  Int?
  type          String   // receipt | receipt_reversal | transfer_out | transfer_in | adjustment | count | reclass | van_load | van_return | van_sale | order_delivery | void_restore | central_return | opening | market_return | damage
  refType       String?
  refId         String?
  refNumber     String?
  userName      String?
  note          String?

  @@index([warehouseId, productId])
  @@index([vanId, productId])
  @@index([createdAt])
}

// Opening stock for a warehouse at go-live: validated line by line, approved, then locked.
model OpeningBalanceBatch {
  id          String   @id @default(cuid())
  warehouseId String
  filename    String?
  asOfDate    DateTime
  uploadedBy  String
  status      String   @default("pending") // pending | approved | rejected
  approvedBy  String?
  decidedAt   DateTime?
  createdAt   DateTime @default(now())

  lines OpeningBalanceLine[]
}

model OpeningBalanceLine {
  id         String              @id @default(cuid())
  batchId    String
  batch      OpeningBalanceBatch @relation(fields: [batchId], references: [id])
  lineNo     Int
  sku        String
  productId  String?
  category   String              @default("good") // good | bad
  lotNumber  String?
  expiryDate DateTime?
  qty        Int
  unitCost   Float?
  result     String              @default("ok") // ok | error
  message    String?
}

// Which warehouse lots are reserved (then dispatched or released) for each order line — FEFO,
// possibly spanning several lots. Reservations leave on-hand stock only at dispatch.
model OrderAllocation {
  id               String   @id @default(cuid())
  salesOrderLineId String
  warehouseId      String
  productId        String
  lotNumber        String
  qty              Int
  status           String   @default("reserved") // reserved | dispatched | released
  createdAt        DateTime @default(now())

  @@index([salesOrderLineId])
}

// ---------------------------------------------------------------------------
// Van counts and end-of-day van reconciliation
// ---------------------------------------------------------------------------

model VanStockCount {
  id        String   @id @default(cuid())
  vanId     String
  countedBy String
  countType String   @default("spot") // start_of_day | mid_day | end_of_day | spot
  blind     Boolean  @default(false)
  status    String   @default("submitted")
  createdAt DateTime @default(now())

  lines VanStockCountLine[]
}

model VanStockCountLine {
  id             String        @id @default(cuid())
  countId        String
  count          VanStockCount @relation(fields: [countId], references: [id])
  productId      String
  lotNumber      String
  systemGood     Int
  systemDamaged  Int
  countedGood    Int
  countedDamaged Int
  variance       Int
  remark         String?
}

model VanReconciliation {
  id          String    @id @default(cuid())
  vanId       String
  dayDate     DateTime
  status      String    @default("open") // closed | pending_ack | variance_open | escalated | carried_over
  countedBy   String?
  cause       String?
  approvedBy  String?
  note        String?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  lines VanReconciliationLine[]

  @@unique([vanId, dayDate])
}

model VanReconciliationLine {
  id               String            @id @default(cuid())
  reconciliationId String
  reconciliation   VanReconciliation @relation(fields: [reconciliationId], references: [id])
  productId        String
  opening          Int
  loaded           Int
  sold             Int
  returned         Int
  adjusted         Int
  expected         Int
  counted          Int
  variance         Int
  outcome          String   // none | within_tolerance | shortage | excess
  resolution       String?  // approved_adjustment | explained | escalated
}
