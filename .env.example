# PostgreSQL connection string (Neon / Vercel Postgres) - the only variable the app needs.
# Use the pooled string for the running app. For `npm run seed` (prisma db push), if it hangs
# or errors on the pooled string, temporarily use the direct (non -pooler) string instead.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
